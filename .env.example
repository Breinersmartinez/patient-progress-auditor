# === Backend (Spring Boot) ===
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patient_auditor
DB_USERNAME=patient_auditor
# Sin valor por defecto: definela antes de correr el backend.
DB_PASSWORD=

# Puerto del backend
PORT=8080

# JWT / Security
# Sin valor por defecto: definela antes de correr el backend.
JWT_SECRET=

# === Frontend (Angular) ===
API_URL=http://localhost:8080/api

# === Proveedor de LLM ===
# Pendiente de decision: anade aqui la variable del proveedor elegido
# (por ejemplo LLM_API_KEY o LLM_MODEL) cuando se cierre en docs/SPEC.md.

# === Postgres de produccion ===
# Los define el proveedor del despliegue (Heroku/Vercel) o el docker-compose:
# PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD
# PORT, SPRING_PROFILES_ACTIVE=prod
