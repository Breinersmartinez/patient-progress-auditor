# Copie este archivo a .env o, mejor, ejecute ./run.sh: genera DB_PASSWORD y
# pregunta por la llave del proveedor solo si hay terminal.
# Nunca ponga una llave real en este archivo: el repositorio es publico.

# === Docker Compose ===
SPRING_PROFILES_ACTIVE=docker

# Base de datos (PostgreSQL). run.sh genera DB_PASSWORD; sin valor por defecto.
DB_NAME=patient_auditor
DB_USERNAME=patient_auditor
DB_PASSWORD=
# URL JDBC que usa el perfil docker (el host "db" es el servicio de Compose).
DATABASE_URL=jdbc:postgresql://db:5432/patient_auditor

# Puertos publicados en la maquina (la base no se publica).
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Datos y usuarios de demostracion (nunca con el perfil prod).
APP_SEED_DEMO=true

# === Proveedor de LLM ===
# Principal: Groq. Respaldo: Gemini (Google AI Studio).
# Si faltan, la aplicacion arranca igual y avisa que falta la llave.
GROQ_API_KEY=
# Si en su .env la llave de respaldo se llama GOOGLE_API_KEY (el nombre del SDK de Google), run.sh la copia a GEMINI_API_KEY.
GEMINI_API_KEY=
# Orden de los proveedores. Para cambiar de proveedor: edite estas dos lineas y ejecute `docker compose up -d backend`.
LLM_PROVIDER=groq
LLM_FALLBACK=gemini
# Modelos (verificados el 2026-10-28; ver docs/decisiones.md).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STRUCTURING_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite

# Limites del agente. Cambiar uno fuerza ese limite en la demo (p. ej. AGENT_MAX_ITERATIONS=1); la ruta normal sigue
# llamando al proveedor real.
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOKENS=30000
AGENT_TOOL_TIMEOUT_SECONDS=5
AGENT_TOOL_DESCRIPTIONS=V2

# === Ejecucion local sin Docker (mvn spring-boot:run, perfil dev) ===
DB_HOST=localhost
DB_PORT=5432
PORT=8080
# Solo si se abre el frontend sin el proxy de ng serve.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# === Perfil prod (Postgres externo) ===
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
