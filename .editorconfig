# https://editorconfig.org — misma sangría y mismos finales de línea en IntelliJ, VS Code y cualquier otro editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# Backend, SQL de Flyway, scripts de Python y plantillas de reportes: 4 espacios.
[*.{java,py,sql,xml,jrxml}]
indent_size = 4

[*.md]
max_line_length = off
